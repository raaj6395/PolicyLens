{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["facts"],
  "properties": {
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "category", "aspect", "value", "status", "sources"],
        "properties": {
          "fact_id": {"type": "string", "pattern": "^F[0-9]+$"},
          "category": {"type": "string"},
          "aspect": {"type": "string"},
          "value": {"type": "string"},
          "status": {"type": "string", "enum": ["FOUND", "MISSING", "CONFLICT"]},
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["doc_id", "quote", "value"],
              "properties": {
                "doc_id": {"type": "string", "pattern": "^D[0-9]+$"},
                "quote": {"type": "string"},
                "value": {"type": "string"},
                "date": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
