# Copy to .env and fill in. Real shell variables override this file. Never commit .env.

# Provider: openai (default) | gemini | groq | ollama.
LLM_PROVIDER=openai

# Gemini (default provider): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq (fallback): https://console.groq.com/keys
GROQ_API_KEY=

# Optional model / endpoint overrides for the selected provider.
# Defaults: gpt-4.1 (openai), gemini-2.5-flash, llama-3.3-70b-versatile, gpt-oss:120b-cloud
LLM_MODEL=gpt-4.1
# e.g. http://host.docker.internal:11434/v1 for Ollama from inside Docker
LLM_BASE_URL=

# If set, POST endpoints require header X-API-Key: <value>
API_KEY=
RATE_LIMIT_PER_MIN=10
PORT=8080
